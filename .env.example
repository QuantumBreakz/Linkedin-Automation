###############################################################################
# Research-to-LinkedIn Automation Platform — environment
#
# Copy to `.env` and fill in. Every variable below is read exactly once, in
# src/lib/env.ts, and validated with Zod at first access. A missing or
# malformed value fails the process at startup with a list of every problem.
#
# `.env` is gitignored. Never commit real values.
###############################################################################

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development


# ── Datastores ───────────────────────────────────────────────────────────────
# Postgres 16. Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_linkedin?schema=public

# Redis 7 — BullMQ queues and the rate limiter. Matches the `redis` service.
REDIS_URL=redis://localhost:6379


# ── Secrets ──────────────────────────────────────────────────────────────────
# AES-256-GCM key for the encrypted LinkedIn token columns. Exactly 32 bytes,
# base64-encoded. Generate with:  openssl rand -base64 32
# Losing this key means every stored LinkedIn token becomes unreadable and all
# users must reconnect. Back it up in your secret manager, not in this repo.
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32

# NextAuth session/JWT signing secret, >= 32 chars.
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_base64_32

# Canonical origin of the app. Must match exactly (scheme, host, port) or
# OAuth callbacks silently fail.
NEXTAUTH_URL=http://localhost:3000


# ── LinkedIn ─────────────────────────────────────────────────────────────────
# From https://www.linkedin.com/developers/apps -> your app -> Auth tab.
# Add BOTH self-serve products on the Products tab (docs/01 §D1):
#   - "Sign In with LinkedIn using OpenID Connect"  -> openid, profile, email
#   - "Share on LinkedIn"                           -> w_member_social
# Neither requires partner approval.
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME

# Must be listed byte-for-byte under "Authorized redirect URLs for your app".
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Master kill switch for real publishing. `true` logs the exact payload the
# adapter would have sent and writes nothing to LinkedIn.
# Defaults to `true` when unset — a forgotten variable must never post to a
# real member's feed. Set to `false` only in staging/production.
LINKEDIN_DRY_RUN=true

# `LinkedIn-Version` header for the versioned /rest API surface (YYYYMM).
LINKEDIN_API_VERSION=202601


# ── LLM ──────────────────────────────────────────────────────────────────────
# Which OpenAI-compatible backend to use: `openrouter` (default) or `groq`.
# Both speak the same /chat/completions format; this switches the base URL, the
# credential, and which model chain applies.
# Model IDs live in src/services/llm/config.ts, never here — roles
# (cheap/standard/verify) map to ordered fallback chains. See docs/01 §D8.
LLM_PROVIDER=openrouter

# From https://openrouter.ai/keys
# Still required by schema validation even when LLM_PROVIDER=groq; a placeholder
# is fine in that case.
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# From https://console.groq.com/keys — required only when LLM_PROVIDER=groq.
# Groq's free tier is rate-limited per minute rather than metered, so no card
# is needed; the `verify` role therefore has no paid tier to fall back to.
# GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1


# ── Object storage (S3-compatible) ───────────────────────────────────────────
# Rendered 1200x1200 PNGs and cached open-access full text.
# Local default is the MinIO service in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=research-linkedin
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# MinIO requires path-style addressing. Set to `false` for AWS S3 or R2.
S3_FORCE_PATH_STYLE=true

# Optional. Public base URL when the bucket sits behind a CDN; when unset the
# app issues short-lived signed URLs instead.
# S3_PUBLIC_URL=https://cdn.example.com


# ── Outbound API etiquette (docs/01 §D5) ─────────────────────────────────────
# A REAL, MONITORED inbox. Sent as `mailto=` to OpenAlex (polite pool), in the
# Crossref/Unpaywall User-Agent, and as the mandatory `email` parameter to NCBI
# E-utilities. A fake address here gets our IP range throttled or blocked.
CONTACT_EMAIL=you@example.com

# Mandatory `tool` parameter for NCBI E-utilities; also our User-Agent product
# token. Should be registered with NCBI.
APP_NAME=research-to-linkedin
APP_URL=http://localhost:3000

# Optional. From https://account.ncbi.nlm.nih.gov/settings/
# Raises the PubMed budget from 3 req/s to 10 req/s.
# NCBI_API_KEY=


# ── Ops ──────────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info

# Optional. Shared secret required by POST /api/internal/cron/:name (docs/07).
# Generate with:  openssl rand -hex 32
# CRON_SECRET=

# Optional. Set to `true` to log every Prisma query in development.
# PRISMA_LOG_QUERIES=false

# ── MongoDB mirror (optional) ────────────────────────────────────────────────
# One-way mirror of the entire Postgres database into MongoDB. PostgreSQL stays
# the system of record — nothing in the app reads from Mongo. Leave MONGODB_URI
# unset to disable. When set, the worker mirrors every 5 minutes; run an
# immediate sync with `npm run sync:mongo`.
# MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?appName=app
# MONGODB_DB=research_linkedin
